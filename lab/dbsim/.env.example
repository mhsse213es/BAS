# Copy to .env (gitignored) and replace EVERY placeholder.
# Use only [A-Za-z0-9] in passwords: they are interpolated into init SQL and
# shell, and smoke.sh sources this file. Generate e.g. with:
#   head -c 48 /dev/urandom | base64 | tr -dc 'A-Za-z0-9' | head -c 24
ELASTIC_PASSWORD=CHANGE_ME_elastic
KIBANA_SYSTEM_PASSWORD=CHANGE_ME_kibana_system
# Three independent Kibana encryption keys, each >= 32 characters.
KIBANA_SECURITY_KEY=CHANGE_ME_at_least_32_characters_a
KIBANA_SAVEDOBJECTS_KEY=CHANGE_ME_at_least_32_characters_b
KIBANA_REPORTING_KEY=CHANGE_ME_at_least_32_characters_c
FILEBEAT_PASSWORD=CHANGE_ME_filebeat_writer
# Read-only account for the detectverify Elastic connector (and smoke.sh).
ALERTS_READER_PASSWORD=CHANGE_ME_alerts_reader
PG_SUPERUSER_PASSWORD=CHANGE_ME_pg_superuser
MYSQL_ROOT_PASSWORD=CHANGE_ME_mysql_root
# Agent-side DB accounts (see README account table).
DBSIM_TEST_PASSWORD=CHANGE_ME_dbsim_test
DBSIM_LAB_PASSWORD=CHANGE_ME_dbsim_lab
