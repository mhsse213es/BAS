*.exe
*.zip
*.tar
*.tar.gz
logs.txt
error.txt
*.txt
!scenarios/*.yaml

# ART external payloads — baked into the bundle at build time; never commit the
# binaries themselves (hacktools), but keep the folder + docs tracked.
packaging/art-payloads/*
!packaging/art-payloads/README.md
!packaging/art-payloads/.gitkeep
.claude/
ag/

# Private keys — NEVER commit any PEM/SSH key (incl. stray keys in repo root)
*.pem
*.key
id_rsa
packaging/licensing/keys/
# Generated customer license files
*.lic

# Build / delivery output and local tooling — never ship via git
dist/
build/
claude-code-security-review/

# Python
api/venv/
api/__pycache__/
**/__pycache__/
*.pyc
*.pyo

# .NET build output
**/bin/
**/obj/

# Node
node_modules/
