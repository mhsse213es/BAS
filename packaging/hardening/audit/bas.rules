## BAS Platform — auditd Rules
## CIS Ubuntu 24.04 Level 2 + BAS-specific monitoring
##
## Install: cp bas.rules /etc/audit/rules.d/bas.rules && augenrules --load
## View:    ausearch -k <key> | aureport
## Report:  aureport --summary
##
## Key naming: bas-*  for BAS-specific events
##             cis-*  for CIS-required events

# ── Flush existing rules ───────────────────────────────────────────────────────
-D

# ── Audit buffer (increase if events are lost — check with: auditctl -s) ───────
-b 8192

# ── Failure mode (1=print warning, 2=panic on overflow) ────────────────────────
-f 1

# ══════════════════════════════════════════════════════════════════════════════
# BAS PLATFORM — application-specific events
# ══════════════════════════════════════════════════════════════════════════════

# BAS environment files (secrets + admin seed)
-w /opt/bas-platform/.env                    -p rwxa -k bas-config
-w /opt/bas-platform/.env.admin-seed         -p rwxa -k bas-config
-w /opt/bas-platform/.configured             -p rwxa -k bas-config

# BAS systemd service files
-w /etc/systemd/system/bas-compose.service   -p rwxa -k bas-service
-w /etc/systemd/system/bas-firstboot.service -p rwxa -k bas-service

# Docker socket (high-privilege access)
-w /var/run/docker.sock                      -p rwxa -k bas-docker

# Docker compose and scenario files
-w /opt/bas-platform/docker-compose.yml      -p wxa  -k bas-config
-w /opt/bas-platform/scenarios/              -p wxa  -k bas-scenarios

# AppArmor profile changes
-w /etc/apparmor.d/bas-orchestrator          -p rwxa -k bas-apparmor

# ══════════════════════════════════════════════════════════════════════════════
# CIS 4.1.3 — Ensure events that modify date and time information are collected
# ══════════════════════════════════════════════════════════════════════════════
-a always,exit -F arch=b64 -S adjtimex -S settimeofday                -k cis-time-change
-a always,exit -F arch=b32 -S adjtimex -S settimeofday -S stime       -k cis-time-change
-a always,exit -F arch=b64 -S clock_settime                           -k cis-time-change
-a always,exit -F arch=b32 -S clock_settime                           -k cis-time-change
-w /etc/localtime                                        -p wa         -k cis-time-change

# ══════════════════════════════════════════════════════════════════════════════
# CIS 4.1.4 — Ensure events that modify user/group information are collected
# ══════════════════════════════════════════════════════════════════════════════
-w /etc/group                                            -p wa         -k cis-identity
-w /etc/passwd                                           -p wa         -k cis-identity
-w /etc/gshadow                                          -p wa         -k cis-identity
-w /etc/shadow                                           -p wa         -k cis-identity
-w /etc/security/opasswd                                 -p wa         -k cis-identity
-w /etc/sudoers                                          -p wa         -k cis-identity
-w /etc/sudoers.d/                                       -p wa         -k cis-identity

# ══════════════════════════════════════════════════════════════════════════════
# CIS 4.1.5 — Ensure events that modify network environment are collected
# ══════════════════════════════════════════════════════════════════════════════
-a always,exit -F arch=b64 -S sethostname -S setdomainname            -k cis-system-locale
-a always,exit -F arch=b32 -S sethostname -S setdomainname            -k cis-system-locale
-w /etc/issue                                            -p wa         -k cis-system-locale
-w /etc/issue.net                                        -p wa         -k cis-system-locale
-w /etc/hosts                                            -p wa         -k cis-system-locale
-w /etc/network/                                         -p wa         -k cis-system-locale

# ══════════════════════════════════════════════════════════════════════════════
# CIS 4.1.6 — Ensure events that modify MAC policy are collected
# ══════════════════════════════════════════════════════════════════════════════
-w /etc/apparmor/                                        -p wa         -k cis-mac-policy
-w /etc/apparmor.d/                                      -p wa         -k cis-mac-policy

# ══════════════════════════════════════════════════════════════════════════════
# CIS 4.1.7 — Ensure login and logout events are collected
# ══════════════════════════════════════════════════════════════════════════════
-w /var/log/faillog                                      -p wa         -k cis-logins
-w /var/log/lastlog                                      -p wa         -k cis-logins
-w /var/log/tallylog                                     -p wa         -k cis-logins

# ══════════════════════════════════════════════════════════════════════════════
# CIS 4.1.8 — Ensure session initiation information is collected
# ══════════════════════════════════════════════════════════════════════════════
-w /var/run/utmp                                         -p wa         -k cis-session
-w /var/log/wtmp                                         -p wa         -k cis-session
-w /var/log/btmp                                         -p wa         -k cis-session

# ══════════════════════════════════════════════════════════════════════════════
# CIS 4.1.9 — Ensure discretionary access control permission modification events
# ══════════════════════════════════════════════════════════════════════════════
-a always,exit -F arch=b64 -S chmod -S fchmod -S fchmodat   -F auid>=1000 -F auid!=-1 -k cis-perm-mod
-a always,exit -F arch=b32 -S chmod -S fchmod -S fchmodat   -F auid>=1000 -F auid!=-1 -k cis-perm-mod
-a always,exit -F arch=b64 -S chown -S fchown -S fchownat -S lchown -F auid>=1000 -F auid!=-1 -k cis-perm-mod
-a always,exit -F arch=b32 -S chown -S fchown -S fchownat -S lchown -F auid>=1000 -F auid!=-1 -k cis-perm-mod
-a always,exit -F arch=b64 -S setxattr -S lsetxattr -S fsetxattr -S removexattr -S lremovexattr -S fremovexattr -F auid>=1000 -F auid!=-1 -k cis-perm-mod
-a always,exit -F arch=b32 -S setxattr -S lsetxattr -S fsetxattr -S removexattr -S lremovexattr -S fremovexattr -F auid>=1000 -F auid!=-1 -k cis-perm-mod

# ══════════════════════════════════════════════════════════════════════════════
# CIS 4.1.10 — Ensure unsuccessful file access attempts are collected
# ══════════════════════════════════════════════════════════════════════════════
-a always,exit -F arch=b64 -S creat -S open -S openat -S truncate -S ftruncate -F exit=-EACCES -F auid>=1000 -F auid!=-1 -k cis-access
-a always,exit -F arch=b32 -S creat -S open -S openat -S truncate -S ftruncate -F exit=-EACCES -F auid>=1000 -F auid!=-1 -k cis-access
-a always,exit -F arch=b64 -S creat -S open -S openat -S truncate -S ftruncate -F exit=-EPERM  -F auid>=1000 -F auid!=-1 -k cis-access
-a always,exit -F arch=b32 -S creat -S open -S openat -S truncate -S ftruncate -F exit=-EPERM  -F auid>=1000 -F auid!=-1 -k cis-access

# ══════════════════════════════════════════════════════════════════════════════
# CIS 4.1.12 — Ensure successful file system mounts are collected
# ══════════════════════════════════════════════════════════════════════════════
-a always,exit -F arch=b64 -S mount -F auid>=1000 -F auid!=-1         -k cis-mounts
-a always,exit -F arch=b32 -S mount -F auid>=1000 -F auid!=-1         -k cis-mounts

# ══════════════════════════════════════════════════════════════════════════════
# CIS 4.1.13 — Ensure file deletion events are collected
# ══════════════════════════════════════════════════════════════════════════════
-a always,exit -F arch=b64 -S unlink -S unlinkat -S rename -S renameat -F auid>=1000 -F auid!=-1 -k cis-delete
-a always,exit -F arch=b32 -S unlink -S unlinkat -S rename -S renameat -F auid>=1000 -F auid!=-1 -k cis-delete

# ══════════════════════════════════════════════════════════════════════════════
# CIS 4.1.14 — Ensure changes to system administration scope (sudoers) are collected
# (already covered by cis-identity above)
# ══════════════════════════════════════════════════════════════════════════════

# ══════════════════════════════════════════════════════════════════════════════
# CIS 4.1.15 — Ensure system administrator command executions (sudo) are collected
# ══════════════════════════════════════════════════════════════════════════════
-a always,exit -F arch=b64 -C euid!=uid -F euid=0 -S execve           -k cis-actions
-a always,exit -F arch=b32 -C euid!=uid -F euid=0 -S execve           -k cis-actions

# ══════════════════════════════════════════════════════════════════════════════
# CIS 4.1.16 — Ensure kernel module loading and unloading is collected
# ══════════════════════════════════════════════════════════════════════════════
-w /sbin/insmod                                          -p x          -k cis-modules
-w /sbin/rmmod                                           -p x          -k cis-modules
-w /sbin/modprobe                                        -p x          -k cis-modules
-a always,exit -F arch=b64 -S init_module -S delete_module             -k cis-modules
-a always,exit -F arch=b32 -S init_module -S delete_module             -k cis-modules

# ══════════════════════════════════════════════════════════════════════════════
# Make audit configuration immutable — requires reboot to change rules
# (CIS 4.1.17 — comment this line out during initial setup/testing)
# ══════════════════════════════════════════════════════════════════════════════
-e 2
