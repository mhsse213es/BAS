#!/bin/bash
# tip-show-credentials: prints the saved MISP / OpenCTI / OpenAEV credentials.
set -euo pipefail
CREDS_FILE=/etc/threat-intelligence-package/credentials.txt
[ "$(id -u)" -eq 0 ] || { echo "run as root: sudo tip-show-credentials" >&2; exit 1; }
[ -r "$CREDS_FILE" ] || { echo "no credentials found; has tip-install completed on this host?" >&2; exit 1; }
cat "$CREDS_FILE"
