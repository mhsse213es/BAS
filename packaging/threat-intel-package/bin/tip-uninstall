#!/bin/bash
# tip-uninstall: removes every MISP, OpenCTI and OpenAEV stack installed by tip-install on this host.
#
# Removes: the three compose stacks and their containers, their Docker volumes (all data: databases,
# uploads, indexes), the generated env files, the stack directory, and the credentials file.
# With --images, also removes the loaded images listed in the bundle's MANIFEST.txt.
#
# Does NOT remove the Docker Engine, the .deb itself (use: apt remove threat-intelligence-package),
# or any data outside these three stacks, such as the BAS platform database.
#
#   sudo tip-uninstall            # asks you to type REMOVE
#   sudo tip-uninstall --yes      # no prompt
#   sudo tip-uninstall --images   # also remove the loaded images
set -uo pipefail

STACK_DIR=/opt/threat-intelligence
SECRET_DIR=/etc/threat-intelligence-package
PKG_SHARE=/usr/share/threat-intelligence-package
YES=0; IMAGES=0
for arg in "$@"; do
  case "$arg" in
    --yes) YES=1 ;;
    --images) IMAGES=1 ;;
    -h|--help) sed -n '2,15p' "$0"; exit 0 ;;
    *) echo "tip-uninstall: unknown option: $arg" >&2; exit 2 ;;
  esac
done

[ "$(id -u)" -eq 0 ] || { echo "tip-uninstall: run with sudo" >&2; exit 1; }

echo "This removes the MISP, OpenCTI and OpenAEV stacks on this host, including ALL their data:"
echo "  containers, Docker volumes, $STACK_DIR and $SECRET_DIR (credentials)."
[ "$IMAGES" -eq 1 ] && echo "  and the loaded images from the bundle."
if [ "$YES" -ne 1 ]; then
  printf "Type REMOVE to continue: "
  read -r answer
  [ "$answer" = "REMOVE" ] || { echo "Cancelled. Nothing was removed."; exit 1; }
fi

# 1. Stop and remove each stack with its volumes.
for s in misp opencti openaev; do
  dir="$STACK_DIR/$s"
  if [ -f "$dir/docker-compose.yml" ] && [ -f "$STACK_DIR/$s.env" ]; then
    echo "==> Stopping $s stack"
    (cd "$dir" && docker compose --env-file "$STACK_DIR/$s.env" -f docker-compose.yml down -v --remove-orphans) \
      || echo "    warning: compose down failed for $s; the fallback below removes what is left"
  fi
done

# 1b. The manual install from before this package: one Compose project named "xtm" started from
# the OpenCTI and OpenAEV files. Bring it down with those exact files so its volumes go too.
# The "audspect" project (the BAS platform) is deliberately not touched here or anywhere below.
legacy=()
for f in /opt/openaev/docker/docker-compose.yml /opt/opencti/docker/docker-compose.yml; do
  [ -f "$f" ] && legacy+=(-f "$f")
done
if [ "${#legacy[@]}" -gt 0 ]; then
  echo "==> Stopping the manual xtm stack (OpenCTI/OpenAEV) and its data"
  (cd /opt/opencti/docker 2>/dev/null || cd /opt/openaev/docker; docker compose -p xtm "${legacy[@]}" down -v --remove-orphans)     || echo "    warning: compose down failed for xtm; check 'docker compose ls -a'"
fi

# 2. Fallback: remove any leftover containers and volumes from these stacks.
docker ps -aq --filter "name=^misp" --filter "name=^opencti" --filter "name=^openaev" 2>/dev/null \
  | xargs -r docker rm -f >/dev/null 2>&1
docker volume ls -q 2>/dev/null | grep -E '^(misp|opencti|openaev)_' | xargs -r docker volume rm >/dev/null 2>&1
docker network ls -q --filter "name=^(misp|opencti|openaev)" 2>/dev/null | xargs -r docker network rm >/dev/null 2>&1

# 3. Optional: remove the loaded images.
if [ "$IMAGES" -eq 1 ] && [ -f "$PKG_SHARE/MANIFEST.txt" ]; then
  echo "==> Removing loaded images"
  while IFS='|' read -r ref _rest; do
    ref="$(echo "$ref" | tr -d '[:space:]')"
    [ -n "$ref" ] || continue
    docker image rm "$ref" >/dev/null 2>&1 || true
  done < <(tail -n +4 "$PKG_SHARE/MANIFEST.txt")
fi

# 4. Remove files written by the installer.
echo "==> Removing $STACK_DIR and $SECRET_DIR"
rm -rf "$STACK_DIR" "$SECRET_DIR"

# 5. Report anything still present.
left=$(docker ps -aq --filter "name=^misp" --filter "name=^opencti" --filter "name=^openaev" 2>/dev/null | wc -l)
vols=$(docker volume ls -q 2>/dev/null | grep -cE '^(misp|opencti|openaev)_' || true)
echo "Left behind: $left containers, $vols volumes (expected 0 0)."
echo "Not removed: the BAS platform database, the Docker Engine and the installed .deb package."
