# ═══════════════════════════════════════════════════════════════════════════════
# Audspect BAS Platform — Installation Configuration Template
#
# Copy this file to setup.conf and fill in your values before the maintenance
# window. All required fields are marked with  ← REQUIRED.
# Run prereq check:   sudo bash install.sh --check --config setup.conf
# Run install:        sudo bash install.sh --install --config setup.conf
# ═══════════════════════════════════════════════════════════════════════════════

# ── [network] ──────────────────────────────────────────────────────────────────
# BAS_HOST is informational only (used in report URLs and setup summary).
#
# This platform now uses four separate listeners, each serving a different
# kind of traffic -- do not point browsers or agents at the wrong one:
#   BAS_PORT           mTLS agent traffic only (no browser access -- requires
#                       a client certificate). Default: 9443
#   BAS_ENROLL_PORT     New-agent enrollment + healthcheck. Default: 9444
#   BAS_LEGACY_PORT     Temporary, pre-migration agents only. Default: 9000
#   BAS_DASHBOARD_PORT  Browser dashboard access. Default: 9543
#
# Run --check first — it will FAIL if any of these ports are already in use
# on this host.
#
# Known conflicts (change the relevant port above if any of these run on
# this server):
#   8443 / 8444  Trellix/McAfee ePO, Carbon Black, Forcepoint
#   8834         Tenable Nessus
#   9000         SonarQube, PHP-FPM  <- also this platform's own BAS_LEGACY_PORT default
#   9090         Prometheus, Cockpit
#   9200         Elasticsearch REST
#   9443         IBM WebSphere AS default HTTPS  <- common in Indian banking cores
#
# Safe alternatives if a default conflicts: 9643/9743 for BAS_PORT or
# BAS_DASHBOARD_PORT; any unclaimed port in the same 9xxx range otherwise.
#
# BAS_TLS enables a properly-trusted certificate on BAS_DASHBOARD_PORT
# (requires TLS_CERT and TLS_KEY below). Leave false to use the deployment
# CA's own self-signed certificate -- browsers will show a security warning,
# and (because the cert is untrusted) may BLOCK the in-console agent-binary
# download even after you click through, failing with a generic "check your
# internet connection" error though the server served the bytes fine. For any
# deployment whose dashboard is used from a real browser, set BAS_TLS=true
# with a TLS_CERT/TLS_KEY your users' browsers already trust.

BAS_HOST=                         # ← REQUIRED  e.g. bas.corp.internal
BAS_PORT=9443                     # Default: 9443 (mTLS agent traffic)
BAS_ENROLL_PORT=9444              # Default: 9444 (agent enrollment)
BAS_LEGACY_PORT=9000              # Default: 9000 (temporary, pre-migration agents)
BAS_DASHBOARD_PORT=9543           # Default: 9543 (browser dashboard)
BAS_TLS=false                     # true | false

# BAS_CSP_MODE sets the dashboard Content-Security-Policy. enforce (default)
# blocks inline script; report-only only logs violations to the orchestrator
# log -- use it temporarily while a reported dashboard problem is fixed, then
# set it back to enforce and re-run --upgrade. There is no "off".
BAS_CSP_MODE=enforce              # enforce | report-only

# ── Phishing identity scenarios: install-wide target allowlists ───────────────
# PH-ID-002 (OAuth consent) and PH-ID-003 (device-code) may read only these
# targets. A run chooses targets from inside this list, never outside it. Leave
# blank to keep both scenarios unavailable. A malformed value refuses the install.
# Users: comma-separated user principal names or object IDs.
AUDSPECT_PHISH_IDENTITY_TARGET_USERS=
# Consent-grant scope for PH-ID-002: comma-separated SERVICE PRINCIPAL OBJECT IDs
# (not application/client IDs) of the enterprise apps whose grants may be
# inspected. Tenant-specific: each installation lists its own tenant's IDs.
# Find one (run as an admin, then compare the Object ID in the Entra admin center,
# Enterprise applications, against the value shown):
#   az ad sp show --id <APPLICATION_ID> --query id -o tsv
# or:  GET https://graph.microsoft.com/v1.0/servicePrincipals?$filter=appId eq '<APPLICATION_ID>'
# The installer checks the format only. It cannot check that the ID belongs to
# this tenant, so verify it before use. PH-ID-002 stays unavailable regardless
# until its Graph permission is approved.
AUDSPECT_PHISH_OAUTH_SP_OBJECT_IDS=

# DNS_SINK_BIND_IP is the host IP the DLP DNS-tunneling sink (UDP/53) binds
# to. Auto-detected (first non-loopback IP via `hostname -I`) if left blank.
# It is deliberately NOT bound to 0.0.0.0 (all interfaces): on most Linux
# hosts, systemd-resolved already listens on 127.0.0.53/127.0.0.54:53, and a
# wildcard bind on the same port conflicts with that (Linux won't let a
# wildcard and a specific-address bind coexist on one port), which prevents
# the orchestrator container's network from attaching at all and crash-loops
# it with a "postgres" DNS-resolution failure. Binding to a specific,
# non-loopback host IP avoids the conflict entirely -- and is more correct
# anyway, since the DNS sink only needs to receive queries from BAS agents
# over the real network, never via loopback. Override only if this host is
# multi-homed and `hostname -I`'s first entry isn't the address agents use
# to reach it.

DNS_SINK_BIND_IP=                 # Auto-detected if blank (recommended)

# BAS_SERVER_SANS is the comma-separated list of hostnames/IPs agents will
# use to reach this orchestrator -- embedded as Subject Alternative Names
# on the deployment CA certificate (which every listener presents directly
# as its TLS identity when BAS_TLS=false below). Without a matching SAN,
# every agent's TLS client rejects the connection outright -- there is no
# CommonName fallback since Go 1.15, so this is not optional for any
# agent connecting by IP, which is the ordinary case for an on-prem box.
# Auto-detected (reuses DNS_SINK_BIND_IP's value) if left blank; add a
# hostname too if agents will also reach this box by DNS name, e.g.
# BAS_SERVER_SANS=192.168.10.78,bas.internal.example.com
BAS_SERVER_SANS=                  # Auto-detected if blank (recommended)

# ── [tls] ──────────────────────────────────────────────────────────────────────
# Required only when BAS_TLS=true. Paths are on the SERVER (not the bundle).
# The installer copies these files into ${DATA_DIR}/certs/ and sets chmod 640.
# Supported: PEM-encoded certificate + private key (RSA or ECDSA).

TLS_CERT=                         # e.g. /etc/pki/tls/certs/bas.crt
TLS_KEY=                          # e.g. /etc/pki/tls/private/bas.key

# ── [storage] ──────────────────────────────────────────────────────────────────
# DATA_DIR is the root directory for all runtime data (Postgres data, logs,
# backups, scenarios). Minimum 10 GB free on the target partition.
# The installer creates sub-directories and sets chmod 750.

DATA_DIR=/opt/audspect            # Default: /opt/audspect

# ── [database] ─────────────────────────────────────────────────────────────────
# Password for the internal Postgres user (bas_user).
# Minimum 8 characters. Generated once; do not change after first install
# without a full DB re-initialisation or manual ALTER ROLE.
# Postgres is NEVER exposed externally — only reachable inside Docker bridge.

DB_PASSWORD=                      # ← REQUIRED  min 8 chars

# ── [logging] ──────────────────────────────────────────────────────────────────
# Log retention window in days. Logs older than this are pruned on each restart.
# SEBI CSCRF / RBI ISMS mandates typically require 180+ days for MII/NBFC.
# Set to 0 to disable automatic pruning.

LOG_RETENTION_DAYS=90             # Default: 90

# ── [security] ─────────────────────────────────────────────────────────────────
# JWT_SECRET signs all dashboard session tokens. Minimum 32 hex chars.
# AGENT_SECRET authenticates enrolled BAS agents. Minimum 24 hex chars.
# Both are AUTO-GENERATED if left blank. Pre-set them here to ensure a
# deterministic value across a clustered or DR deployment.
# Values are written to ${DATA_DIR}/.env (chmod 600, readable by root only).

JWT_SECRET=                       # Auto-generated if blank  (recommended)
AGENT_SECRET=                     # Auto-generated if blank  (recommended)

# ── [admin] ────────────────────────────────────────────────────────────────────
# First-run admin account. Created once at install; ignored on upgrade.
# Use a service account email owned by the security operations team.

ADMIN_EMAIL=                      # ← REQUIRED  e.g. bas-admin@corp.internal
ADMIN_PASSWORD=                   # ← REQUIRED  min 10 chars

# ── [licence] ──────────────────────────────────────────────────────────────────
# Path to the Audspect licence file (.lic) delivered with the bundle -- kept
# under its own issued filename (e.g. hdfc-prod-001.lic for customer ID
# hdfc-prod-001) end-to-end, never renamed to a generic bas.lic. The
# installer copies it to ${DATA_DIR}/<its own filename> (chmod 644) and
# records that filename as LICENSE_FILE in .env.

LIC_PATH=                         # ← REQUIRED  e.g. /home/ubuntu/hdfc-prod-001.lic

# ── [validation-lab] ─────────────────────────────────────────────────────────────
# Threat-Content-Factory Phase 6. Leave VALIDATION_LAB_AGENT_ID blank to keep
# the validation lab disabled (the orchestrator logs "[validationlab] disabled").
# To enable it, enroll an agent, set its agent_id here, and re-run --upgrade.
# The orchestrator then marks that agent (and only it) as the dedicated lab
# automatically on startup -- no manual database change is needed.
# A lab agent is DEDICATED: once set it is barred from normal assessment runs
# (and normal agents are barred from validation runs), so use a machine you are
# not also using for regular assessments. With it set, generated content
# advances Candidate -> Validated -> Published on the Factory Health page.

VALIDATION_LAB_AGENT_ID=          # Blank = lab disabled (default)
VALIDATION_LAB_POLL_MINUTES=5     # Default: 5
