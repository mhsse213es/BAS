# ─────────────────────────────────────────────────────────────────────────────
# BAS Platform — Environment Configuration
#
# THIS FILE IS A PRE-INSTALL TEMPLATE, NOT THE LIVE CONFIG. It ships inert in
# the release bundle -- install.sh never reads or writes it. The real runtime
# .env that the containers use lives at ${DATA_DIR}/.env (default
# /opt/audspect/.env), written by `install.sh --install --config setup.conf`
# from your setup.conf values. Troubleshooting a running deployment? Check
# THAT file, not this one.
#
# For production, use install.sh --install --config setup.conf (see
# setup.conf.template) -- it generates and validates the real .env for you.
# To hand-edit instead (dev/manual setups only): copy this file to .env in
# this same directory and fill in every CHANGE_ME.
# ─────────────────────────────────────────────────────────────────────────────

# ── Version ───────────────────────────────────────────────────────────────────
# Set to the version string passed to windows-build.ps1 (e.g. 1.7.1).
BAS_VERSION=1.7.1
COMPOSE_PROJECT_NAME=audspect

# Registry prefix for images (leave empty for locally built images).
# Example for private registry: REGISTRY=registry.internal/bas/
REGISTRY=

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_DB=bas_platform
POSTGRES_USER=bas_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Optional — DB role hardening. Set a strong password to demote the orchestrator's
# Postgres role (bas_user) to NOSUPERUSER/NOBYPASSRLS at startup so Row-Level
# Security can enforce, and to create a `bas_breakglass` recovery superuser with
# this password. Recovery: connect as bas_breakglass and run
#   ALTER ROLE bas_user SUPERUSER;
# Leave blank to keep hardening inactive (default).
BAS_DB_BREAKGLASS_PASSWORD=

# ── Security (REQUIRED — change before first run) ─────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_32_CHAR_HEX_SECRET

# Shared secret required by agents on X-Agent-Token header.
# Generate with: openssl rand -hex 24
AGENT_SECRET=CHANGE_ME_24_CHAR_HEX_SECRET

# OPTIONAL — enables POST /api/ingest/v1/events, the generic inbound
# detection/evidence ingestion API for your own SIEM/SOAR/ITSM tooling
# (see docs/guides/ingestion-api.md). Leave unset/empty to keep the
# endpoint disabled (the default) -- unlike AGENT_SECRET, this one is not
# auto-generated by install.sh, since enabling an external-facing write
# endpoint should be an explicit choice, not a silent default.
# Generate with: openssl rand -hex 32
#BAS_INGEST_API_KEY=

# ── Admin Bootstrap (REQUIRED — change before first run) ──────────────────────
# First-run admin account, created/synced on every orchestrator startup by
# ensureAdminUser (cmd/server/main.go) so this stays the source of truth.
# WARNING: if BAS_ADMIN_PASSWORD is left blank, the orchestrator does NOT
# refuse to start -- it falls back to a well-known default (admin /
# ChangeMe!2024, with a forced password-change flag). Do not deploy with
# this blank.
BAS_ADMIN_EMAIL=CHANGE_ME_admin@yourcompany.com
BAS_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD_MIN_10_CHARS

# ── Network & TLS ───────────────────────────────────────────────────────────────
BAS_PORT=9443

# BAS_TLS enables HTTPS termination inside the orchestrator. Defaults to
# false (plaintext HTTP) if left blank -- set to true and provide TLS_CERT/
# TLS_KEY below unless TLS is already terminated by an upstream load balancer.
BAS_TLS=false
# Required only when BAS_TLS=true. Paths are on the HOST running Docker
# Compose (PEM-encoded certificate + private key, RSA or ECDSA).
TLS_CERT=
TLS_KEY=

# Dashboard Content-Security-Policy: enforce (default) or report-only.
# report-only logs violations instead of blocking them; use only while a
# reported dashboard problem is being fixed, then set back to enforce.
BAS_CSP_MODE=enforce

# ── Storage & Logging ────────────────────────────────────────────────────────
# Root directory for all runtime data (Postgres data, logs, backups, scenarios).
DATA_DIR=/opt/audspect

# Log retention window in days; logs older than this are pruned on each
# restart. Set to 0 to disable pruning. SEBI CSCRF / RBI ISMS mandates
# typically require 180+ days for MII/NBFC deployments.
LOG_RETENTION_DAYS=90

# ── License ───────────────────────────────────────────────────────────────────
# Filename of your license file, exactly as issued by
# packaging/licensing/licensegen (e.g. hdfc-prod-001.lic for customer ID
# hdfc-prod-001) -- kept under its own name end-to-end, never renamed to a
# generic bas.lic. Place the file at ${DATA_DIR}/<this filename> on the
# host; docker-compose.yml mounts it into the container and derives
# BAS_LICENSE_PATH from it automatically.
LICENSE_FILE=bas.lic

# ── Caldera (MITRE ATT&CK simulation engine) ──────────────────────────────────
# Generate with: openssl rand -hex 20
CALDERA_API_KEY=CHANGE_ME_CALDERA_RED_KEY
CALDERA_API_KEY_BLUE=CHANGE_ME_CALDERA_BLUE_KEY
# Override Caldera URL if running on a separate host or without Docker DNS.
# Default (http://caldera:8888) works when all containers share the same
# Docker Compose network. If Caldera is on a different host, set this to
# its reachable IP, e.g.: CALDERA_URL=http://192.168.11.155:8888
CALDERA_URL=

# ── SharpHound AD Collector (OPTIONAL) ───────────────────────────────────────
# Enables Active Directory graph collection from domain-joined agents.
# 1. Download SharpHound.exe from the BloodHound Community Edition release page.
# 2. Place it in the host directory named by SHARPHOUND_DIR below (default
#    ./sharphound) as SharpHound.exe.
# 3. Set BAS_SHARPHOUND_PATH below to where that lands INSIDE the container --
#    /sharphound/SharpHound.exe matches the default bind mount.
# Leave BAS_SHARPHOUND_PATH blank to disable SharpHound (reachability +
# local-admin collection still work without it).
SHARPHOUND_DIR=./sharphound
BAS_SHARPHOUND_PATH=

# ── Threat-Intel Connector (OPTIONAL) ─────────────────────────────────────────
# Server-side only. Polls MISP / OpenCTI and auto-generates intel scenarios into
# scenarios/intel/. Leave blank to disable. Configure on the SERVER, not agents.
#
# MISP: API key from MISP → Administration → List Auth Keys
MISP_URL=
MISP_API_KEY=
#
# OpenCTI: API token from OpenCTI → Profile → API access
OPENCTI_URL=
OPENCTI_API_KEY=
#
# How often to poll (hours). Default 24. TTPs change slowly — daily is plenty.
THREAT_INTEL_POLL_HOURS=24

# ── OTX IOC Enrichment (OPTIONAL) ──────────────────────────────────────────────
# Distinct from the MISP/OpenCTI connector above. Enriches indicators (IPs,
# domains, URLs, hashes, CVEs) extracted from run execution evidence against
# LevelBLUE OTX (AlienVault Open Threat Exchange). Leave blank to disable —
# extraction still runs and populates run_iocs, just without external lookups.
# Get a key: https://otx.alienvault.com → account icon → API Integration.
OTX_API_KEY=
