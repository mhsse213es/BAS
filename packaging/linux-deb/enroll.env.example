# /etc/audspect-agent/enroll.env: how this host reaches your Audspect server.
#
# Create it BEFORE installing the package (sudo install -d -m 0755 /etc/audspect-agent), owned by root, mode 0600:
#   sudo install -m 0600 /dev/null /etc/audspect-agent/enroll.env   then edit it
# The package then enrols the host as it installs. Or install first and run:  sudo audspect-agent-setup
#
# The agent secret and enrolment token are removed from this file once they have been used.

# The Audspect server (host name or address; no scheme, no port).
BAS_SERVER_HOST=audspect.example.com

# Ports shown on the console's Deploy Agent page (these are the defaults).
BAS_MTLS_PORT=9443
BAS_ENROLL_PORT=9445
BAS_DASHBOARD_PORT=9543

# Label shown for this endpoint's environment.
BAS_ENV_LABEL=Production

# The agent secret from the Deploy Agent page.
BAS_AGENT_SECRET=

# Only if the server issues single-use enrolment tokens (a token is bound to one host).
BAS_ENROLLMENT_TOKEN=

# Strongly recommended: the SHA-256 fingerprint of your deployment CA, shown on the Deploy Agent page. Without it the
# CA is trusted on first contact.
BAS_CA_FINGERPRINT=

# Optional: a copy of the deployment CA (PEM) already on this host, so it is not fetched from the server.
BAS_CA_FILE_PATH=
