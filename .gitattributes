# Linux-targeted text must stay LF, even when checked out on a Windows build
# host with core.autocrlf=true. A CRLF here breaks the client at runtime —
# e.g. bash reads `set -o pipefail\r` and rejects `pipefail\r` as an invalid
# option. These files are copied into the delivery bundle and run on the
# client's Ubuntu server.
*.sh        text eol=lf
*.conf      text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.service   text eol=lf
.env        text eol=lf
.env.*      text eol=lf

# G1 audit artifacts: the classifier/tracer write CSV rows with CRLF (Python's
# csv default) on every OS. Normalizing keeps CI's freshness diff
# (.github/workflows/test.yml) comparing content, not line endings.
security/g1/G1_*.csv   text eol=lf
security/g1/G1_*.json  text eol=lf
# G1c: the generator and split:check compare bytes, so web sources are LF on
# every platform (Windows checkouts would otherwise get CRLF).
orchestrator/web/**/*.html text eol=lf
orchestrator/web/**/*.css text eol=lf
orchestrator/web/**/*.js text eol=lf
orchestrator/web/**/*.mjs text eol=lf
orchestrator/web/**/*.json text eol=lf
orchestrator/web/**/*.sh text eol=lf
orchestrator/web/**/*.md text eol=lf
orchestrator/web/.gitignore text eol=lf
